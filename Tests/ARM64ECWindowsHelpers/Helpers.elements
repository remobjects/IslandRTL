<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build"><PropertyGroup><OutputType>StaticLibrary</OutputType><BinaryName>Helpers</BinaryName><Mode>Island</Mode><SubMode>Windows</SubMode><Architecture>arm64ec</Architecture><NoGC>True</NoGC><NoRTL>True</NoRTL><NoIsland>True</NoIsland><AllowGlobals>True</AllowGlobals><EnableAsserts>False</EnableAsserts><GenerateDebugInfo>False</GenerateDebugInfo><GenerateIRFile>True</GenerateIRFile><DefaultGlobalsToPublic>True</DefaultGlobalsToPublic></PropertyGroup><ItemGroup><Reference Include="rtl"><HintPath>$(FixtureDir)\rtl.fx</HintPath></Reference><Reference Include="Island"><HintPath>$(FixtureDir)\Island.fx</HintPath></Reference><Compile Include="Helpers.pas"/></ItemGroup><Import Project="$(MSBuildExtensionsPath)\RemObjects Software\Elements\RemObjects.Elements.Island.Windows.targets"/></Project>