<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" DefaultTargets="Build">
  <PropertyGroup>
    <ProjectGuid>{8D97AF43-6E82-4EBD-A2B6-6F5C9C9584F8}</ProjectGuid>
    <OutputType>Executable</OutputType><AssemblyName>CommandLineArguments</AssemblyName>
